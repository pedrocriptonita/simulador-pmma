# ============================================================
# Simulador PM MA 2026 — Variáveis de ambiente
# Copie este arquivo para .env.local (app) e .env (Prisma CLI)
# e preencha com os valores do seu projeto Supabase.
# ATENÇÃO: nunca coloque chaves reais NESTE arquivo — ele é
# commitado no git. Chaves reais vão em .env.local / .env.
# Se a senha do banco tiver caracteres especiais (? # @ etc.),
# use URL-encoding na connection string (ex.: ? => %3F, # => %23).
# ============================================================

# Postgres via pooler do Supabase (runtime da aplicação)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (usada pelo Prisma nas migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# URL pública do site (SEO, sitemap, links de e-mail). Ex.: https://app.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Tag Manager (Meta Pixel é configurado dentro do container do GTM).
# Pegue em tagmanager.google.com — formato GTM-XXXXXXX. Vazio => GTM não carrega.
NEXT_PUBLIC_GTM_ID=""

# Supabase — projeto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Server-only — NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Checkout externo (Fase 6)
# PAYMENT_PROVIDER: "cakto" usa o adapter da Cakto (segredo dentro do
#   corpo do JSON, comprador identificado por e-mail). "generic" (padrão)
#   usa o contrato canônico. Usando Cakto sem isto, o webhook é rejeitado.
# CHECKOUT_URL: link do produto no provedor.
#   Vazio => botão de assinar fica em modo "em configuração".
# CHECKOUT_WEBHOOK_SECRET: segredo do webhook. Na Cakto quem gera é ela,
#   no painel, ao criar o webhook — copie de lá, não invente um.
PAYMENT_PROVIDER="cakto"
CHECKOUT_URL=""
CHECKOUT_WEBHOOK_SECRET="<segredo-forte>"

# Credenciais do admin criado pelo seed (apenas .env.local)
SEED_ADMIN_EMAIL="<email-admin>"
SEED_ADMIN_PASSWORD="<senha-forte>"
