# ============================================================
# Simulador PM MA 2026 — Variáveis de ambiente
# Copie este arquivo para .env.local (app) e .env (Prisma CLI)
# e preencha com os valores do seu projeto Supabase.
# ============================================================

# Postgres via pooler do Supabase (runtime da aplicação)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta (usada pelo Prisma nas migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase — projeto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Server-only — NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Segredo do webhook do provedor de checkout (Fase 6)
CHECKOUT_WEBHOOK_SECRET="placeholder"
